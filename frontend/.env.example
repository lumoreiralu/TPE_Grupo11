# URL del gateway usada por el proxy de Vite (dev y preview).
VITE_GATEWAY_URL=http://localhost:8080

# Opcional: si se define, el navegador llama directo a esta URL en lugar de usar el proxy.
# Requiere CORS habilitado en el gateway.
# VITE_API_BASE_URL=http://localhost:8080

# Máximo de entradas por compra. Debe coincidir con compras.limite-entradas-por-cliente.
VITE_MAX_ENTRADAS=4
